{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sass-maker/saas-maker/tooling/agent-testing/manifest.schema.json",
  "title": "Fleet local agent-testing benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "platform", "journey", "candidate", "sample", "workingDirectory", "runs", "phases"],
  "properties": {
    "schemaVersion": { "const": "fleet.agent-testing.manifest.v1" },
    "id": { "$ref": "#/$defs/identifier" },
    "platform": { "enum": ["web", "ios", "android", "desktop", "other"] },
    "journey": { "$ref": "#/$defs/identifier" },
    "candidate": { "$ref": "#/$defs/identifier" },
    "sample": { "enum": ["screening", "qualification", "exploration"] },
    "workingDirectory": { "type": "string", "minLength": 1 },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warm", "cold"],
      "anyOf": [
        { "properties": { "warm": { "minimum": 1 } } },
        { "properties": { "cold": { "minimum": 1 } } }
      ],
      "properties": {
        "warm": { "type": "integer", "minimum": 0, "maximum": 100 },
        "cold": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "verification"],
      "properties": {
        "setup": { "$ref": "#/$defs/phase" },
        "reset": { "$ref": "#/$defs/phase" },
        "readiness": { "$ref": "#/$defs/phase" },
        "observation": { "$ref": "#/$defs/phase" },
        "workflow": { "$ref": "#/$defs/phase" },
        "verification": { "$ref": "#/$defs/phase" },
        "teardown": { "$ref": "#/$defs/phase" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "timeoutMs"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 600000 }
      }
    }
  }
}
