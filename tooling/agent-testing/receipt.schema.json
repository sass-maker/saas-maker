{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sass-maker/saas-maker/tooling/agent-testing/receipt.schema.json",
  "title": "Fleet local agent-testing benchmark receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmark", "startedAt", "completedAt", "setup", "teardown", "runs"],
  "properties": {
    "schemaVersion": { "const": "fleet.agent-testing.receipt.v1" },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "platform", "journey", "candidate", "sample", "runs"],
      "properties": {
        "schemaVersion": { "const": "fleet.agent-testing.manifest.v1" },
        "id": { "type": "string" },
        "platform": { "enum": ["web", "ios", "android", "desktop", "other"] },
        "journey": { "type": "string" },
        "candidate": { "type": "string" },
        "sample": { "enum": ["screening", "qualification", "exploration"] },
        "runs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warm", "cold"],
          "properties": {
            "warm": { "type": "integer", "minimum": 0 },
            "cold": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "setup": { "anyOf": [{ "$ref": "#/$defs/phaseResult" }, { "type": "null" }] },
    "teardown": { "anyOf": [{ "$ref": "#/$defs/phaseResult" }, { "type": "null" }] },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "temperature", "iteration", "status", "totalMs", "phases", "metrics", "artifacts"],
        "properties": {
          "runId": { "type": "string" },
          "temperature": { "enum": ["warm", "cold"] },
          "iteration": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["passed", "incorrect", "failed", "timed_out"] },
          "totalMs": { "type": "number", "minimum": 0 },
          "phases": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reset": { "$ref": "#/$defs/phaseResult" },
              "readiness": { "$ref": "#/$defs/phaseResult" },
              "observation": { "$ref": "#/$defs/phaseResult" },
              "workflow": { "$ref": "#/$defs/phaseResult" },
              "verification": { "$ref": "#/$defs/phaseResult" }
            }
          },
          "metrics": { "$ref": "#/$defs/metrics" },
          "artifacts": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "phaseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "durationMs", "exitCode"],
      "properties": {
        "status": { "enum": ["passed", "failed", "timed_out", "skipped"] },
        "durationMs": { "type": "number", "minimum": 0 },
        "exitCode": { "type": ["integer", "null"] },
        "reason": {
          "enum": ["spawn-error", "timeout", "nonzero-exit", "invalid-adapter-output", "earlier-phase-failed"]
        },
        "metrics": { "$ref": "#/$defs/metrics" },
        "artifacts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setupMs": { "$ref": "#/$defs/nonnegative" },
        "resetMs": { "$ref": "#/$defs/nonnegative" },
        "readinessMs": { "$ref": "#/$defs/nonnegative" },
        "observationMs": { "$ref": "#/$defs/nonnegative" },
        "modelMs": { "$ref": "#/$defs/nonnegative" },
        "controlMs": { "$ref": "#/$defs/nonnegative" },
        "applicationWaitMs": { "$ref": "#/$defs/nonnegative" },
        "controlAndApplicationWaitMs": { "$ref": "#/$defs/nonnegative" },
        "verificationMs": { "$ref": "#/$defs/nonnegative" },
        "unassignedMs": { "$ref": "#/$defs/nonnegative" },
        "modelCalls": { "$ref": "#/$defs/counter" },
        "inputTokens": { "$ref": "#/$defs/counter" },
        "outputTokens": { "$ref": "#/$defs/counter" },
        "imageInputs": { "$ref": "#/$defs/counter" },
        "apiSpendUsd": { "$ref": "#/$defs/nonnegative" },
        "subscriptionUnits": { "$ref": "#/$defs/nonnegative" },
        "seededDefectsDetected": { "$ref": "#/$defs/counter" },
        "seededDefectsMissed": { "$ref": "#/$defs/counter" },
        "falseAlarms": { "$ref": "#/$defs/counter" },
        "retries": { "$ref": "#/$defs/counter" },
        "manualInterventions": { "$ref": "#/$defs/counter" }
      }
    },
    "nonnegative": { "type": "number", "minimum": 0 },
    "counter": { "type": "integer", "minimum": 0 }
  }
}
