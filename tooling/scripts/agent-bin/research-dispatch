#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "usage: research-dispatch <research question>" >&2
  exit 2
fi

exec openclaw agent \
  --agent research \
  --message "Research this request evidence-first: restate the decision, cite primary sources, separate facts from inference, and end with a recommendation. Save a decision-ready report in reports/ before replying: $*"
