{
  "name": "@saas-maker/collect",
  "version": "0.3.0",
  "description": "Bounded HTTP-first web extraction with opt-in installed-Chrome rendering.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "crawl": "node scripts/crawl.mjs",
    "doctor": "node scripts/doctor.mjs",
    "jobs": "node scripts/scrape-jobs.mjs",
    "macos:install": "node scripts/macos-launch-agent.mjs install",
    "macos:status": "node scripts/macos-launch-agent.mjs status",
    "macos:validate": "node scripts/macos-launch-agent.mjs validate",
    "macos:uninstall": "node scripts/macos-launch-agent.mjs uninstall",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test",
    "check": "pnpm test && pnpm pack --dry-run"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "playwright-core": "1.63.0"
  },
  "license": "MIT",
  "files": [
    "src/*.mjs",
    "src/*.d.mts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/collect.d.mts",
      "import": "./src/collect.mjs"
    }
  },
  "types": "./src/collect.d.mts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sass-maker/saas-maker.git",
    "directory": "tooling/collect"
  },
  "publishConfig": {
    "access": "public"
  }
}
