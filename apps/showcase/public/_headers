# HTML: browsers always revalidate (max-age=0); the edge may serve a copy for
# 5 minutes and refresh it for 1 more minute (s-maxage + stale-while-revalidate),
# so a deployment is visible within about 6 minutes without a per-request origin
# round trip. Hash-stable Astro bundles remain immutable below.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=60

/*.html
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=60

/p/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=60

/projects.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff

/project-strip.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400
  Content-Type: text/javascript; charset=utf-8
  X-Content-Type-Options: nosniff

/ai-chat-footer.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400
  Content-Type: text/javascript; charset=utf-8
  X-Content-Type-Options: nosniff

/feedback-launcher.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400
  Content-Type: text/javascript; charset=utf-8
  X-Content-Type-Options: nosniff

# Astro emits hash-stable bundles under /_astro/.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted webfont. The filename carries the upstream release (v7), so a new
# cut lands under a new name and this can stay immutable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
