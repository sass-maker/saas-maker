---
import { PACKAGE_HOST } from '../data/links';

const INSTALL = 'pnpm add @saas-maker/feedback';
---
<section class="studio-package" id="package" aria-labelledby="package-title">
  <div class="package-copy">
    <p class="studio-kicker">Open-source package</p>
    <h2 id="package-title">@saas-maker/feedback</h2>
    <p>
      A small React widget for bugs, feature requests, screenshots, and
      page-specific feedback. Use the hosted SaaS Maker service or keep
      submission and storage inside your application.
    </p>
  </div>
  <div class="package-action">
    <p>Install it in one line</p>
    <code>{INSTALL}</code>
    <a href={`https://${PACKAGE_HOST}`} target="_blank" rel="noopener noreferrer" data-app-health-event="feedback_docs_opened">
      Read the package docs ↗
    </a>
  </div>
  <div class="feedback-preview" aria-labelledby="feedback-preview-title">
    <div class="feedback-preview-head">
      <div>
        <p class="studio-kicker">Example workspace · illustrative data</p>
        <h3 id="feedback-preview-title">A place to sort product feedback.</h3>
        <p>When your widget is connected, submissions land in an inbox where you can track their type and status.</p>
      </div>
      <a href="https://app.sassmaker.com/login?returnTo=feedback">Set up your product ↗</a>
    </div>
    <ul class="feedback-preview-list" aria-label="Example feedback items">
      <li>
        <div><strong>Example: Export should include filtered rows</strong><span>Feature request · Example workspace</span></div>
        <span class="feedback-preview-status">New</span>
      </li>
      <li>
        <div><strong>Example: Keyboard focus skips the close button</strong><span>Bug report · Example workspace</span></div>
        <span class="feedback-preview-status feedback-preview-status--active">Investigating</span>
      </li>
      <li>
        <div><strong>Example: Remember the selected workspace</strong><span>Feedback · Example workspace</span></div>
        <span class="feedback-preview-status feedback-preview-status--done">Resolved</span>
      </li>
    </ul>
    <p class="feedback-preview-note">These rows are examples, not live submissions or customer activity.</p>
  </div>
</section>
