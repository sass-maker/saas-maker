---
import { CORE } from '../data/projects';
import { STUDIO_PROFILE } from '../data/studio';

const PLAQUE_TONES = ['cobalt', 'oxblood', 'amber'];
---

<header class="studio-hero" aria-labelledby="studio-title">
  <div class="studio-hero-scene" aria-hidden="true">
    <img
      src="/images/glazier-atelier-hero.webp"
      srcset="/images/glazier-atelier-hero-800.webp 800w, /images/glazier-atelier-hero.webp 1600w"
      sizes="100vw"
      alt=""
      width="1600"
      height="1120"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="studio-hero-head">
    <p class="studio-kicker">{STUDIO_PROFILE.eyebrow}</p>
    <h1 id="studio-title">{STUDIO_PROFILE.headline}</h1>
    <div class="studio-hero-aside">
      <p class="studio-intro">{STUDIO_PROFILE.oneLine}</p>
      <a class="studio-thesis-link" href="/projects">
        Explore the complete directory <span aria-hidden="true">→</span>
      </a>
      <p class="studio-status">
        <span aria-hidden="true"></span>
        Directory, packages, and tooling · kept current
      </p>
    </div>
  </div>

  <ol class="product-ledger" aria-label="Products in focus">
    {CORE.map((project, index) => (
      <li>
        <a
          class={`ledger-plaque ledger-plaque--${PLAQUE_TONES[index % PLAQUE_TONES.length]}`}
          href={project.href}
        >
          <span class="ledger-count">{String(index + 1).padStart(2, '0')}</span>
          <strong>{project.name}</strong>
          <span class="ledger-description">{project.desc}</span>
          <span class="ledger-dest">
            <span class="ledger-domain">{project.tag}</span>
            <span class="ledger-cta">Details <span aria-hidden="true">→</span></span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</header>
