---
import Commission from './Commission.astro';
import GitHubIcon from './GitHubIcon.astro';
import { GITHUB_REPO_URL } from '../data/links';
const { showCommission = false } = Astro.props;
const OWNER_URL = 'https://sarthakagrawal.dev';
const isChangelog = Astro.url.pathname.startsWith('/changelog');
---
<fleet-footer-extension
  product-name="SaaS Maker"
  font-base="/fonts/fleet-footer-precise-v1/"
  theme="light"
  art-src="/footer-art/saas-maker.webp"
  art-alt="A pixel art studio courtyard with a central craft table, tools, and shelves of finished and unfinished models."
  art-width="2170"
  art-height="725"
  art-position="50% 50%"
  art-credit="Original illustration for SaaS Maker"
>
  {showCommission && <div slot="cta" data-fleet-footer-cta><Commission contained /></div>}
<footer class="footer" slot="navigation" data-fleet-footer-navigation>
  <div class="footer-brand">
    <span class="brand-mark sm" aria-hidden="true">S</span>
    <span>Built and maintained by <a href={OWNER_URL} target="_blank" rel="noopener noreferrer">Sarthak Agrawal</a></span>
  </div>
  <div class="footer-links">
    <a href="/changelog" aria-current={isChangelog ? 'page' : undefined}>Changelog</a>
    <a href="/learnings">Learnings</a>
    <a href="/ranks">Ranks</a>
    <a href="/privacy">Privacy</a>
    <a href="/terms">Terms</a>
    <a
      href={GITHUB_REPO_URL}
      aria-label="GitHub repository"
      title="GitHub repository"
      target="_blank"
      rel="noopener noreferrer"><GitHubIcon /></a>
  </div>
  <p class="footer-tagline">Curious products. Real domains. Work that keeps moving.</p>
</footer>
</fleet-footer-extension>

<style>
  fleet-footer-extension { display:block; color:inherit; font:inherit; }
  .footer.footer { width:100%; margin:0; border-top:0; padding:0; }
  .footer-links a { display:inline-flex; align-items:center; justify-content:center; min-width:2.75rem; min-height:2.75rem; }
  .footer-brand a { text-underline-offset:.2em; }
  @media(max-width:760px) { .footer-brand { align-items:flex-start; } .footer-links { justify-content:flex-start; column-gap:1rem; row-gap:0; } }
</style>
