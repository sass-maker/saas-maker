---
/**
 * THESIS: Launch destinations are working material, like the idea ledger — the value is
 * comparing provenance and tradeoffs, not scrolling a wall of links.
 * OWN-WORLD: Same workshop interior as /ideas; the catalog renders as an operator ledger.
 * STORY: See the honest headline numbers, narrow by route/link/category, read each row's
 * source history before trusting its metrics.
 * FIRST VIEWPORT: Studio navigation, identity bay with counts, then the controls and ledger.
 * FORM: Operator ledger within the established workshop wall; no new visual world.
 */
import Footer from '../components/Footer.astro';
import CatalogActions from '../components/CatalogActions.astro';
import Nav from '../components/Nav.astro';
import coverageData from '../data/launch-coverage.json';
import { DIRECTORY_PROJECTS } from '../data/directory';
import { launchdeskEvent } from '../data/launchdesk-analytics';
import launchdeskData from '../data/launchdesk.json';
import Layout from '../layouts/Layout.astro';

type Claim = {
  source: string | null;
  dr: number | null;
  link: string | null;
  pricing: string | null;
  type?: string | null;
};
type Destination = {
  name: string;
  domain: string;
  website: string;
  submissionUrl: string | null;
  exampleUrl: string | null;
  category: string;
  type: string | null;
  pricing: string;
  dr: number | null;
  link: string;
  eligibility: string | null;
  flags: string[];
  route: string;
  provider: string | null;
  sourceUrl: string | null;
  retrieved: string | null;
  measured: string | null;
  quarantined: boolean;
  claims: Claim[];
};

const playbookModules = import.meta.glob('../data/launchdesk-playbooks/*.json');
const playbookDomains = new Set(
  Object.keys(playbookModules)
    .map((path) => path.split('/').pop()?.replace(/\.json$/, ''))
    .filter((domain): domain is string => Boolean(domain) && domain !== '_schema')
);

const allDestinations = launchdeskData.destinations as Destination[];
const destinations = allDestinations.filter((row) => !row.quarantined);
const quarantined = allDestinations.filter((row) => row.quarantined);
const categories = [...new Set(destinations.map((row) => row.category))].sort();
const routeCount = destinations.filter((row) => row.submissionUrl).length;
const followCount = destinations.filter((row) => row.link === 'follow').length;
const drReportedCount = destinations.filter((row) => row.dr != null).length;

const LINK_LABELS: Record<string, string> = {
  follow: 'follow',
  nofollow: 'nofollow',
  unknown: 'unreported',
};

const PRICING_LABELS: Record<string, string> = {
  free: 'free',
  freemium: 'freemium',
  paid: 'paid',
  unknown: 'unreported',
};

type CoverageEntry = { state: string; recordedAt: string; reason?: string };
type CoverageRecord = {
  destinations: Record<string, CoverageEntry>;
  externalTargets?: Record<string, CoverageEntry>;
};
const coverageProjects = coverageData.projects as Record<string, CoverageRecord>;
const coveredStates = new Set(coverageData.coveredStates);
const coverageRows = DIRECTORY_PROJECTS.map((project) => {
  const record = coverageProjects[project.id];
  const entries = Object.values(record?.destinations ?? {});
  return {
    id: project.id,
    name: project.name,
    covered: entries.filter((entry) => coveredStates.has(entry.state)).length,
    attempted: entries.length,
    external: Object.keys(record?.externalTargets ?? {}).length,
  };
}).sort(
  (a, b) => b.covered - a.covered || b.attempted - a.attempted || a.name.localeCompare(b.name)
);
---

<Layout
  title={`Launch catalog — ${destinations.length} source-attributed destinations`}
  description={`Browse ${destinations.length} launch and submission destinations with reported DR, link type, pricing, and source history. Every metric shows its provenance.`}
>
  <div class="workshop-world interior-world launchdesk-world">
    <Nav />
    <main id="main-content" class="launchdesk-page">
    <header class="launchdesk-hero">
      <div class="launchdesk-identity">
        <p class="launchdesk-kicker">SaaS Maker / Launch catalog</p>
        <h1>Your next place to launch.</h1>
        <p>
          {destinations.length} submission destinations with their metrics left on the source's
          name tag. DR is reported, not measured — read the history before you trust a row.
          Rows with a <em>Submission playbook</em> link open a free agent-executable
          submission guide; the whole workflow ships as <a href="/launchkit">Launchkit</a>.
        </p>
      </div>
      <dl class="launchdesk-summary" aria-label="Catalog summary">
        <div>
          <dt>Destinations</dt>
          <dd>{destinations.length}</dd>
        </div>
        <div>
          <dt>Submission routes</dt>
          <dd>{routeCount}</dd>
        </div>
        <div>
          <dt>Reported follow</dt>
          <dd>{followCount}</dd>
        </div>
      </dl>
    </header>

    <section class="launchdesk-workbench" aria-labelledby="launchdesk-catalog-title">
      <div class="launchdesk-intro">
        <div>
          <p class="launchdesk-kicker">Destination workbench</p>
          <h2 id="launchdesk-catalog-title">Narrow by fit, verify the paper trail.</h2>
        </div>
        <details>
          <summary>How to read the numbers</summary>
          <p>
            <strong>Reported DR</strong> is what a source claimed, not a fresh measurement.
            Blank means the source didn't report one — it never means zero.
          </p>
          <p>
            <strong>Route</strong> is a submission URL the source published. Rows marked
            "research needed" still merit a look — the route just isn't recorded yet.
          </p>
          <p>
            When sources disagree on DR or link type, every claim is listed under
            the row's source history. Snapshot: {launchdeskData.snapshot}.
          </p>
        </details>
      </div>

      <form class="launchdesk-controls" data-ld-controls>
        <label class="launchdesk-search">
          <span>Search destinations</span>
          <input
            type="search"
            name="query"
            placeholder="Name or domain…"
            autocomplete="off"
            data-ld-query
          />
        </label>

        <label>
          <span>Category</span>
          <select name="category" data-ld-category>
            <option value="">All categories</option>
            {categories.map((category) => <option value={category}>{category}</option>)}
          </select>
        </label>

        <label>
          <span>Link type</span>
          <select name="link" data-ld-link>
            <option value="">Any link</option>
            <option value="follow">follow</option>
            <option value="nofollow">nofollow</option>
            <option value="unknown">unreported</option>
          </select>
        </label>

        <label>
          <span>Price</span>
          <select name="pricing" data-ld-pricing>
            <option value="">Any price</option>
            <option value="free">free</option>
            <option value="freemium">freemium</option>
            <option value="paid">paid</option>
            <option value="unknown">unreported</option>
          </select>
        </label>

        <label>
          <span>Min reported DR</span>
          <input type="number" name="dr" min="0" max="100" value="0" step="1" data-ld-dr />
        </label>

        <label class="launchdesk-sort-mobile">
          <span>Sort</span>
          <select name="sort" data-ld-sort>
            <option value="dr:desc">Reported DR, high to low</option>
            <option value="dr:asc">Reported DR, low to high</option>
            <option value="name:asc">Name, A–Z</option>
            <option value="name:desc">Name, Z–A</option>
            <option value="category:asc">Category, A–Z</option>
            <option value="category:desc">Category, Z–A</option>
            <option value="type:asc">Type, A–Z</option>
            <option value="type:desc">Type, Z–A</option>
            <option value="link:asc">Link type, A–Z</option>
            <option value="link:desc">Link type, Z–A</option>
            <option value="pricing:asc">Price, free first</option>
            <option value="pricing:desc">Price, paid first</option>
            <option value="retrieved:desc">Source retrieved, newest first</option>
            <option value="retrieved:asc">Source retrieved, oldest first</option>
          </select>
        </label>

        <label>
          <span>Submission guide</span>
          <select name="playbook" data-ld-playbook>
            <option value="">Any destination</option>
            <option value="1">Has researched playbook</option>
            <option value="0">Catalog record only</option>
          </select>
        </label>

        <label class="launchdesk-route-toggle">
          <input type="checkbox" name="route" data-ld-route />
          <span>Has submission route</span>
        </label>

        <div class="launchdesk-result-line">
          <output data-ld-count aria-live="polite">Showing all {destinations.length} destinations</output>
          <CatalogActions />
        </div>
      </form>

      <div class="launchdesk-table-wrap">
        <table class="launchdesk-table">
          <thead>
            <tr>
              <th scope="col" data-sort-heading="dr" aria-sort="descending">
                <button type="button" data-sort="dr">Reported DR</button>
              </th>
              <th scope="col" data-sort-heading="name">
                <button type="button" data-sort="name">Destination</button>
              </th>
              <th scope="col" data-sort-heading="link">
                <button type="button" data-sort="link">Link</button>
              </th>
              <th scope="col" data-sort-heading="category">
                <button type="button" data-sort="category">Category</button>
              </th>
              <th scope="col" data-sort-heading="type">
                <button type="button" data-sort="type">Type</button>
              </th>
              <th scope="col">Price</th>
              <th scope="col">Route</th>
            </tr>
          </thead>
          <tbody data-ld-body>
            {destinations.map((row) => (
              <tr
                data-ld-row
                data-dr={row.dr ?? ''}
                data-name={`${row.name} ${row.domain}`.toLowerCase()}
                data-namekey={row.name.toLowerCase()}
                data-title={row.name}
                data-domain={row.domain}
                data-website={row.website}
                data-submission={row.submissionUrl ?? ''}
                data-source={row.sourceUrl ?? ''}
                data-retrieved={row.retrieved ?? ''}
                data-playbook={playbookDomains.has(row.domain) ? '1' : '0'}
                data-link={row.link}
                data-category={row.category}
                data-type={row.type ?? ''}
                data-pricing={row.pricing}
                data-route={row.submissionUrl ? '1' : '0'}
              >
                <td class:list={['ld-dr', { 'ld-dr--reported': row.dr != null }]} data-label="Reported DR">
                  {row.dr ?? <span class="ld-blank" title="Not reported by the source">—</span>}
                </td>
                <td class="ld-destination" data-label="Destination">
                  <details class="ld-disclosure" data-ld-disclosure>
                    <summary>
                      <span class="ld-name">{row.name}</span>
                      <span class="ld-domain">{row.domain}</span>
                    </summary>
                    <div class="ld-detail">
                      <p>
                        <a
                          href={row.website}
                          target="_blank"
                          rel="noopener noreferrer"
                          data-app-health-event={launchdeskEvent(row.domain, 'resource')}
                        >
                          {row.website}
                        </a>
                      </p>
                      {row.exampleUrl && (
                        <p>
                          <a href={row.exampleUrl} target="_blank" rel="noopener noreferrer">
                            Example listing ↗
                          </a>
                        </p>
                      )}
                      {row.eligibility && <p>{row.eligibility}</p>}
                      <p>
                        <a
                          href={`/launchdesk/${row.domain}`}
                          data-app-health-event={launchdeskEvent(row.domain, 'playbook')}
                        >
                          {playbookDomains.has(row.domain)
                            ? 'Submission playbook →'
                            : 'Catalog record →'}
                        </a>
                      </p>
                      {row.provider && <p class="ld-provider">Metric provenance: {row.provider}</p>}
                      {row.claims.length > 1 && (
                        <p class="ld-provider">
                          Sources disagree — {row.claims.length} claims on file.
                        </p>
                      )}
                      <ul class="ld-claims">
                        {row.claims.map((claim) => (
                          <li>
                            <code>{claim.source}</code>
                            <span>
                              {claim.dr != null ? 'DR ' + claim.dr : 'DR unreported'} · {claim.link} · {claim.pricing}
                              {claim.type ? ` · ${claim.type}` : ''}
                            </span>
                          </li>
                        ))}
                      </ul>
                      <p class="ld-provider">
                        Retrieved {row.retrieved}
                        {row.measured ? ` · measured ${row.measured}` : ' · never independently measured'}
                      </p>
                    </div>
                  </details>
                </td>
                <td class="ld-tag" data-label="Link">
                  <span class={`ld-pill ld-pill--${row.link}`}>{LINK_LABELS[row.link] ?? row.link}</span>
                </td>
                <td class="ld-tag" data-label="Category">{row.category}</td>
                <td class="ld-tag" data-label="Type">
                  {row.type ?? <span class="ld-blank" title="Not reported by the source">—</span>}
                </td>
                <td class="ld-tag" data-label="Price">
                  <span class={`ld-pill ld-pill--price-${row.pricing}`}>{PRICING_LABELS[row.pricing] ?? row.pricing}</span>
                </td>
                <td class="ld-route" data-label="Route">
                  {row.submissionUrl ? (
                    <a
                      href={row.submissionUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="ld-route-link"
                      data-app-health-event={launchdeskEvent(row.domain, 'submitIntent')}
                    >
                      Submit ↗
                    </a>
                  ) : (
                    <span class="ld-blank">research needed</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="launchdesk-empty" data-ld-empty hidden>
        <strong>No destinations match this cut.</strong>
        <p>Reset the controls to return to the complete ledger.</p>
        <button type="button" data-ld-empty-reset>Show all destinations</button>
      </div>

      <details class="launchdesk-quarantined">
        <summary>{quarantined.length} rows held back for review</summary>
        <p>
          These source rows looked like non-destinations or carried suspect data. They stay
          in the audit record but out of the active catalog.
        </p>
        <ul>
          {quarantined.map((row) => (
            <li>
              <span class="ld-name">{row.name}</span>
              <span class="ld-domain">{row.domain}</span>
              <small>{row.flags.join(' · ')}</small>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <section class="launchdesk-coverage" aria-labelledby="launchdesk-coverage-title">
      <div class="launchdesk-intro">
        <div>
          <p class="launchdesk-kicker">Coverage by project</p>
          <h2 id="launchdesk-coverage-title">How far each product has been posted.</h2>
        </div>
        <details>
          <summary>How coverage is counted</summary>
          <p>
            <strong>Covered</strong> counts destinations recorded as submitted, queued,
            scheduled, or live for that project. Skipped and prepared rows stay in the
            ledger but do not move the bar.
          </p>
          <p>
            Agents mark the ledger as submissions post;
            <code>tooling/launchkit/scripts/sync-coverage.mjs</code> projects the private
            receipts into the checked-in public file. Machine-readable at
            <a href="/launch-coverage.json">/launch-coverage.json</a>.
          </p>
        </details>
      </div>
      <div class="launchdesk-table-wrap">
        <table class="launchdesk-table coverage-table">
          <thead>
            <tr>
              <th scope="col">Project</th>
              <th scope="col">Covered</th>
              <th scope="col">Attempted</th>
              <th scope="col">List PRs</th>
              <th scope="col" class="coverage-share-head">Coverage</th>
            </tr>
          </thead>
          <tbody>
            {coverageRows.map((row) => {
              const pct = (row.covered / destinations.length) * 100;
              return (
                <tr>
                  <td class="coverage-project" data-label="Project">
                    <a href={row.id === 'saas-maker' ? '/' : `/p/${row.id}`}>{row.name}</a>
                  </td>
                  <td class="ld-tag" data-label="Covered">{row.covered}</td>
                  <td class="ld-tag" data-label="Attempted">{row.attempted}</td>
                  <td class="ld-tag" data-label="List PRs">
                    {row.external > 0 ? row.external : <span class="ld-blank">—</span>}
                  </td>
                  <td class="coverage-share" data-label="Coverage">
                    <span class="coverage-bar" role="img" aria-label={`${pct.toFixed(1)}% covered`}>
                      <span style={`width: ${Math.max(pct, 0.4)}%`} />
                    </span>
                    <span class="coverage-num">{pct.toFixed(1)}%</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <aside class="launchdesk-method" aria-labelledby="launchdesk-method-title">
      <div>
        <p class="launchdesk-kicker">Provenance</p>
        <h2 id="launchdesk-method-title">Every metric keeps its source's name.</h2>
      </div>
      <div>
        <p>
          The catalog was assembled {launchdeskData.snapshot} from {destinations.length + quarantined.length} deduplicated
          source-backed records. Metrics are source-reported and may disagree between providers —
          the raw claims ship with each row rather than being smoothed away.
        </p>
        <a href="/launchdesk.json">Open the complete JSON dataset <span aria-hidden="true">→</span></a>
        <a href="https://github.com/sass-maker/saas-maker" target="_blank" rel="noopener noreferrer">
          SaaS Maker source <span aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
    </main>
    <Footer />
  </div>
</Layout>

<script>
  import { bindCatalogControls, compareKnown, recordedDate } from '../lib/catalog-controls';

  const controls = document.querySelector<HTMLFormElement>('[data-ld-controls]');
  const body = document.querySelector<HTMLElement>('[data-ld-body]');
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('[data-ld-row]'));
  const query = controls?.querySelector<HTMLInputElement>('[data-ld-query]');
  const minimumDr = controls?.querySelector<HTMLInputElement>('[data-ld-dr]');
  const routeOnly = controls?.querySelector<HTMLInputElement>('[data-ld-route]');
  const sort = controls?.querySelector<HTMLSelectElement>('[data-ld-sort]');
  const count = document.querySelector<HTMLElement>('[data-ld-count]');
  const empty = document.querySelector<HTMLElement>('[data-ld-empty]');
  const disclosures = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-ld-disclosure]'));
  const mobileLayout = window.matchMedia('(max-width: 47.99rem)');
  const PRICE_RANK: Record<string, number> = { free: 0, freemium: 1, paid: 2 };

  function valueFor(row: HTMLTableRowElement, key: string) {
    if (key === 'dr') return row.dataset.dr ? Number(row.dataset.dr) : null;
    if (key === 'name') return row.dataset.namekey ?? '';
    if (key === 'pricing') return PRICE_RANK[row.dataset.pricing ?? ''] ?? null;
    if (key === 'retrieved') return recordedDate(row.dataset.retrieved);
    if (key === 'link' && row.dataset.link === 'unknown') return null;
    return row.dataset[key] || null;
  }

  function render() {
    if (!body || !count || !empty) return;
    const search = query?.value.trim().toLowerCase() ?? '';
    const minimum = Number(minimumDr?.value || 0);
    const [key, direction] = (sort?.value || 'dr:desc').split(':');
    const ordered = rows.toSorted((a, b) => compareKnown(valueFor(a, key), valueFor(b, key), direction)
      || (a.dataset.namekey ?? '').localeCompare(b.dataset.namekey ?? ''));
    let visibleCount = 0;
    for (const row of ordered) {
      const matches = (!routeOnly?.checked || row.dataset.route === '1')
        && ['category', 'link', 'pricing', 'playbook'].every(filter => {
          const value = controls?.querySelector<HTMLSelectElement>(`[data-ld-${filter}]`)?.value;
          return !value || row.dataset[filter] === value;
        })
        && (minimum <= 0 || (row.dataset.dr !== '' && Number(row.dataset.dr) >= minimum))
        && (!search || row.dataset.name?.includes(search));
      row.hidden = !matches;
      if (matches) visibleCount += 1;
      body.append(row);
    }
    count.textContent = visibleCount === rows.length ? `Showing all ${rows.length} destinations` : `Showing ${visibleCount} of ${rows.length} destinations`;
    empty.hidden = visibleCount > 0;
    document.querySelectorAll<HTMLElement>('[data-sort-heading]').forEach(heading => {
      if (heading.dataset.sortHeading === key) heading.setAttribute('aria-sort', direction === 'desc' ? 'descending' : 'ascending');
      else heading.removeAttribute('aria-sort');
    });
  }

  function exportRows() {
    const visible = Array.from(body?.querySelectorAll<HTMLTableRowElement>('[data-ld-row]') ?? []).filter(row => !row.hidden);
    return [['Destination', 'Domain', 'Category', 'Type', 'Reported DR (source claim)', 'Link type', 'Reported pricing', 'Website', 'Submission URL', 'Has researched playbook', 'Source URL', 'Source retrieved'],
      ...visible.map(({ dataset: d }) => [d.title, d.domain, d.category, d.type, d.dr, d.link, d.pricing, d.website, d.submission, d.playbook === '1' ? 'Yes' : 'No', d.source, d.retrieved])];
  }

  if (controls) {
    const update = bindCatalogControls(controls, render, exportRows, 'launch-results.csv');
    document.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach(button => {
      button.addEventListener('click', () => {
        if (!sort) return;
        const [key, direction] = sort.value.split(':');
        sort.value = `${button.dataset.sort}:${key === button.dataset.sort ? (direction === 'asc' ? 'desc' : 'asc') : (button.dataset.sort === 'dr' ? 'desc' : 'asc')}`;
        update();
      });
    });
    document.querySelector('[data-ld-empty-reset]')?.addEventListener('click', () => { controls.reset(); query?.focus(); });
  }
  function syncDisclosures() {
    if (mobileLayout.matches) for (const disclosure of disclosures) disclosure.open = false;
  }
  syncDisclosures();
  mobileLayout.addEventListener('change', syncDisclosures);
</script>

<style>
  .launchdesk-page {
    width: var(--frame-width);
    margin-inline: auto;
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .launchdesk-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(19rem, 0.7fr);
    gap: 1px;
    padding: 1px;
    padding-top: 0;
    background: var(--line);

  border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .launchdesk-identity,
  .launchdesk-summary {
    border: 0;
    background: var(--surface);

  border-radius: var(--radius);
}

  .launchdesk-identity {
    padding: clamp(3rem, 6vw, 6rem);
  }

  .launchdesk-kicker {
    color: var(--copper-hi);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .launchdesk-identity h1 {
    max-width: 10ch;
    margin-top: 1.25rem;
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .launchdesk-identity > p:last-child {
    max-width: 42rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.7vw, 1.25rem);
  }

  .launchdesk-summary {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    list-style: none;
  }

  .launchdesk-summary > div {
    min-height: 8.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .launchdesk-summary > div:nth-child(2) {
    background: var(--surface-muted);

  border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .launchdesk-summary > div:last-child {
    border-bottom: 0;
    background: var(--surface);
    color: var(--ink);

  border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .launchdesk-summary dt {
    color: var(--ink-muted);
    font-size: 0.75rem;
    font-weight: 700;
