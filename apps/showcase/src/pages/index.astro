---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TokenWorld from '../components/TokenWorld.astro';
import Fleet from '../components/Fleet.astro';
import Spec from '../components/Spec.astro';
import Footer from '../components/Footer.astro';
import { STUDIO_PROFILE } from '../data/studio';

// Public product directory plus the one published SaaS Maker package.
---

<Layout
  title="SaaS Maker — Fleet products and shared tooling"
  description={STUDIO_PROFILE.oneLine}
>
  <!-- Dark cockpit cards share the public directory's tokens. Product plaques
       retain their saturated hover and keyboard-focus fills. -->
  <div class="workshop-world">
    <Nav />
    <main id="main-content">
      <Hero />
      <Fleet />
      <Spec />
      <TokenWorld />
    </main>
    <Footer showCommission />
  </div>
</Layout>
