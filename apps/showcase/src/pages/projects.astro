---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import {
  ARCHIVED_DIRECTORY_PROJECTS,
  ARCHIVED_REPOSITORY_PROJECTS,
  directoryFormFamilies,
  type DirectoryProject,
} from '../data/directory';
import { formatDirectoryDate } from '../data/format-directory-date';
import {
  PROJECTS_DIRECTORY_COUNT as DIRECTORY_COUNT,
  PROJECTS_DIRECTORY_FORMS as DIRECTORY_FORMS,
  PROJECTS_DIRECTORY_GROUPS as DIRECTORY_GROUPS,
  PROJECTS_DIRECTORY_PLATFORMS as DIRECTORY_PLATFORMS,
} from '../data/projects-directory';
import Layout from '../layouts/Layout.astro';
const availabilityLabel = (availability: DirectoryProject['availability']) => ({
  'public-link': 'Public destination available',
  'no-public-link': 'No public product link',
  'not-publicly-available': 'Not publicly available',
  'internal-private': 'Internal or private',
  'preview-not-qualified': 'Preview · not qualified for public use',
  'unreleased-prototype': 'Unreleased prototype',
})[availability];

const deploymentLabel = (project: DirectoryProject) => {
  if (project.group === 'past' && project.deployed) return 'Live archive';
  if (project.deployed) return 'Deployed';
  if (project.lifecycle === 'local-only' || project.platforms.includes('Local')) return 'Local only';
  return 'Not deployed';
};

const searchableText = (project: DirectoryProject) =>
  [
    project.name,
    project.description,
    project.makerNote,
    ...Object.values(project.purposeContract ?? {}),
    project.form,
    ...project.platforms,
    ...project.technologies,
    ...(project.domains ?? []),
  ]
    .join(' ')
    .toLocaleLowerCase();

const projectCountLabel = (count: number) => `${count} ${count === 1 ? 'project' : 'projects'}`;
const projectProfilePath = (project: DirectoryProject) =>
  project.id === 'saas-maker' ? '/' : `/p/${project.id}`;
---

<Layout
  title={`${projectCountLabel(DIRECTORY_COUNT)} — SaaS Maker Products`}
  description={`${DIRECTORY_COUNT} current product profiles with clear public availability labels. Historical identities remain in a separate archive.`}
>
  <!--
  THESIS: A complete portfolio is clearest as a working register, not a promotional card grid.
  OWN-WORLD: Limestone panes, matte-black mullions, seeded metadata bays, and one cobalt index pane extend the SaaS Maker workshop wall.
  STORY: Understand the current project boundary, narrow it by form or platform, then inspect purpose, maker rationale, public links, stack, and Git span.
  FIRST VIEWPORT: A wide identity pane and cobalt count pane sit above a black filter rail; the first current-project rows begin without a marketing detour.
  FORM: Lifecycle bays crossed by platform and technology rails; fourth grounded structure, seed 2aaa2e62.
  -->
  <div class="workshop-world directory-world">
    <Nav />
    <main id="main-content" class="directory-shell">
      <header class="directory-intro">
        <div class="directory-intro-copy">
          <p class="directory-kicker">The product register</p>
          <h1>{DIRECTORY_COUNT} current products.<br />Availability made clear.</h1>
          <p>
            Browse the current products and their purpose, platform, and public access status.
            A profile can be visible here without being available for public use.
          </p>
        </div>
        <div class="directory-count-pane" aria-label={`${projectCountLabel(DIRECTORY_COUNT)} current profiles`}>
          <strong>{DIRECTORY_COUNT}</strong>
          <span>current profiles</span>
          <small>{ARCHIVED_DIRECTORY_PROJECTS.length} archived identities kept separately</small>
        </div>
      </header>

      <section
        id="directory-filters"
        class="directory-controls"
        data-directory-controls
        hidden
        aria-label="Filter the project directory"
      >
        <div class="directory-search">
            <label for="directory-search">Search name, purpose, or stack</label>
          <input
            id="directory-search"
            name="query"
            type="search"
            inputmode="search"
            autocomplete="off"
            placeholder="Try SwiftUI, Cloudflare, video…"
          />
        </div>

        <div class="directory-selects">
          <label>
            <span>Form family</span>
            <select id="directory-form" name="form">
              <option value="">Every form family</option>
              {DIRECTORY_FORMS.map((form) => <option value={form}>{form}</option>)}
            </select>
          </label>
          <label>
            <span>Platform</span>
            <select id="directory-platform" name="platform">
              <option value="">Every platform</option>
              {DIRECTORY_PLATFORMS.map((platform) => <option value={platform}>{platform}</option>)}
            </select>
          </label>
        </div>

        <div class="directory-groups" role="group" aria-label="Project lifecycle">
          <button type="button" data-group-filter="all" aria-pressed="true">All</button>
          {DIRECTORY_GROUPS.map((group) => (
            <button type="button" data-group-filter={group.id} aria-pressed="false">
              {group.label}
            </button>
          ))}
        </div>

        <div class="directory-result-line">
          <p id="directory-result-count" aria-live="polite">Showing all {projectCountLabel(DIRECTORY_COUNT)}</p>
          <button id="directory-reset" type="button">Reset filters</button>
        </div>
      </section>

      <div class="directory-sections" data-directory-root>
        {DIRECTORY_GROUPS.map((group) => (
          <section class="directory-section" data-directory-section={group.id} aria-labelledby={`directory-${group.id}`}>
            <header class="directory-section-head">
              <div>
                <p data-directory-section-count>{projectCountLabel(group.projects.length)}</p>
                <h2 id={`directory-${group.id}`}>{group.label}</h2>
              </div>
              <p>{group.description}</p>
            </header>

            <div class="directory-column-guide" aria-hidden="true">
              <span>Project</span>
              <span>Shape</span>
              <span>Prominent tools</span>
              <span>Availability</span>
              <span>Profile</span>
            </div>

            <div class="directory-rows">
              {group.projects.map((project) => (
                <details
                  class="directory-row"
                  data-directory-row
                  data-group={project.group}
                  data-form={directoryFormFamilies(project).join('|')}
                  data-platforms={project.platforms.join('|')}
                  data-search={searchableText(project)}
                >
                  <summary class="directory-summary" aria-label={`Open profile for ${project.name}`}>
                    <h3 class="directory-identity">
                      {project.logoUrl && (
                        <img class="directory-project-logo" src={project.logoUrl} alt="" width="48" height="48" loading="lazy" />
                      )}
                      <span class="directory-identity-copy">
                        <span class="directory-row-heading">
                          <span class="directory-project-name">{project.name}</span>
                        </span>
                        <span class="directory-identity-description">
                          {project.description}
                        </span>
                      </span>
                    </h3>

                    <span class="directory-glance">
                      <span>Shape</span>
                      <strong>{project.form}</strong>
                      <small>{project.platforms.join(' · ')}</small>
                    </span>

                    <span class="directory-glance directory-glance--tools">
                      <span>Prominent tools</span>
                      <strong>{project.technologies.join(' · ')}</strong>
                    </span>

                    <span class="directory-glance directory-glance--where">
                      <span>Availability</span>
                      <strong>{availabilityLabel(project.availability)}</strong>
                    </span>

                    <span class="directory-disclosure" aria-hidden="true">
                      <span>Profile</span>
                      <svg viewBox="0 0 16 16" focusable="false">
                        <path d="M3.5 6 8 10.5 12.5 6" />
                      </svg>
                    </span>
                  </summary>

                  <div class="directory-detail">
                    <div class="directory-links-panel">
                      <span>Public destinations</span>
                      <div class="directory-links" aria-label={`${project.name} public links`}>
                        <a class="directory-link--profile" href={projectProfilePath(project)}>
                          Read profile <span aria-hidden="true">→</span>
                        </a>
                        {project.publicUrl && (
                          <a class="directory-link--primary" href={project.publicUrl} target="_blank" rel="noopener noreferrer">
                            {project.publicUrlLabel ?? 'Open product'} <span aria-hidden="true">↗</span>
                          </a>
                        )}
                        {(project.domains ?? [])
                          .filter((domain) => {
                            if (!project.publicUrl) return true;
                            try {
                              return new URL(project.publicUrl).hostname !== domain;
                            } catch {
                              return true;
                            }
                          })
                          .map((domain) => (
                            <a href={`https://${domain}`} target="_blank" rel="noopener noreferrer">
                              {domain} <span aria-hidden="true">↗</span>
                            </a>
                          ))}
                        {project.repositoryUrl && (
                          <a href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">
                            Source <GitHubIcon /> <span aria-hidden="true">↗</span>
                          </a>
                        )}
                        {project.changelogUrl && (
                          <a href={project.changelogUrl} target="_blank" rel="noopener noreferrer">
                            Changelog <span aria-hidden="true">↗</span>
                          </a>
                        )}
                        {project.roadmapUrl && (
                          <a href={project.roadmapUrl} target="_blank" rel="noopener noreferrer">
                            Issues <span aria-hidden="true">↗</span>
                          </a>
                        )}
                        {!project.publicUrl && !project.repositoryUrl && !(project.domains ?? []).length && (
                          <span>No public destination</span>
                        )}
                      </div>
                    </div>

                    <dl class="directory-evidence">
                      <div>
                        <dt>Purpose</dt>
                        <dd>{project.purposeContract.purpose}</dd>
                      </div>
                      <div>
                        <dt>For</dt>
                        <dd>{project.purposeContract.audience}</dd>
                      </div>
                      <div>
                        <dt>Outcome</dt>
                        <dd>{project.purposeContract.outcome}</dd>
                      </div>
                      <div>
                        <dt>How</dt>
                        <dd>{project.purposeContract.mechanism}</dd>
                      </div>
                        {project.purposeContract.proof && (
                          <div>
                            <dt>Evidence</dt>
                            <dd>{project.purposeContract.proof}</dd>
                          </div>
                        )}
                        {project.purposeContract.nextAction && (
                          <div>
                            <dt>Next action</dt>
                            <dd>{project.purposeContract.nextAction}</dd>
                          </div>
                        )}
                        {project.kind && (
                          <div>
                            <dt>Catalog kind</dt>
                            <dd>{project.kind}</dd>
                          </div>
                        )}
                        {project.deployed !== undefined && (
                          <div>
                            <dt>Deployment</dt>
                            <dd>
                              <span class:list={['deployment-state', { 'deployment-state--live': project.deployed }]}>
                                {deploymentLabel(project)}
                              </span>
                              {(project.deploymentProviders ?? []).length > 0 && (
                                <small>{project.deploymentProviders?.join(' · ')}</small>
                              )}
                            </dd>
                          </div>
                        )}
                        {project.firstCommitAt !== undefined && (
                          <div>
                            <dt>First retained commit</dt>
                            <dd>{project.firstCommitAt ? <time datetime={project.firstCommitAt}>{formatDirectoryDate(project.firstCommitAt)}</time> : 'Not retained'}</dd>
                          </div>
                        )}
                        {project.latestCommitAt !== undefined && (
                          <div>
                            <dt>Latest retained commit</dt>
                            <dd>{project.latestCommitAt ? <time datetime={project.latestCommitAt}>{formatDirectoryDate(project.latestCommitAt)}</time> : 'Not retained'}</dd>
                          </div>
                        )}
                    </dl>
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>

      <section class="directory-archive" aria-label="Archived project identities">
        <details>
          <summary>
            Archive <span>{ARCHIVED_DIRECTORY_PROJECTS.length} historical identities</span>
          </summary>
          <p>
            These identities remain available for historical reference and are not part of the
            current roster. Archive profiles do not publish public access links.
          </p>
          <ul>
            {ARCHIVED_DIRECTORY_PROJECTS.map((project) => (
              <li>
                <div>
                  <a href={`/p/${project.id}`}>{project.name}</a>
                  <p>{project.description}</p>
                </div>
                <small>{project.form} · {project.platforms.join(' · ')} · archived</small>
              </li>
            ))}
          </ul>
        </details>
        <details>
          <summary>
            Past standalone repositories <span>{ARCHIVED_REPOSITORY_PROJECTS.length} historical routes</span>
          </summary>
          <p>
            These public source profiles remain available at their historical URLs. They are
            separate from the current product roster and archived product identities.
          </p>
          <ul>
            {ARCHIVED_REPOSITORY_PROJECTS.map((project) => (
              <li>
                <div>
                  <a href={project.profileUrl}>{project.name}</a>
                  <p>{project.description}</p>
                </div>
                <small><a href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">Public source ↗</a></small>
              </li>
            ))}
          </ul>
        </details>
      </section>

      <section class="directory-empty" data-directory-empty hidden aria-live="polite">
        <strong>No projects match those filters.</strong>
        <p>Clear the filters to return to the complete register.</p>
        <button type="button" data-empty-reset>Show all {DIRECTORY_COUNT}</button>
      </section>

      <aside class="directory-provenance" aria-labelledby="directory-provenance-title">
        <div>
          <p class="directory-kicker">How to read this</p>
          <h2 id="directory-provenance-title">A profile is not a public access promise.</h2>
        </div>
        <div>
          <p>
            The current register contains {DIRECTORY_COUNT} profiles, including products that are internal or
            private. Only approved public destinations appear as tryable links. Older identities
            remain in the separate archive.
          </p>
          <p>“Public destination” means a product link is listed; it is not a live health check.</p>
          <p>Public profiles explain purpose and platform. They do not include private operational or assessment data.</p>
          <a href="/projects.json">Open the current product JSON <span aria-hidden="true">→</span></a>
          <a href="/archive.json">Open the archive JSON <span aria-hidden="true">→</span></a>
        </div>
      </aside>

      <button class="directory-filter-return" data-directory-filter-return hidden type="button">
        <span data-filter-return-count>{DIRECTORY_COUNT}</span> <span data-filter-return-label>{DIRECTORY_COUNT === 1 ? 'result' : 'results'}</span> · Filters
      </button>
    </main>
    <Footer />
  </div>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('[data-directory-root]');
  const controls = document.querySelector<HTMLElement>('[data-directory-controls]');
  const footer = document.querySelector<HTMLElement>('studio-footer');
  const filterReturn = document.querySelector<HTMLButtonElement>('[data-directory-filter-return]');
  const filterReturnCount = document.querySelector<HTMLElement>('[data-filter-return-count]');
  const filterReturnLabel = document.querySelector<HTMLElement>('[data-filter-return-label]');
  const search = document.querySelector<HTMLInputElement>('#directory-search');
  const form = document.querySelector<HTMLSelectElement>('#directory-form');
  const platform = document.querySelector<HTMLSelectElement>('#directory-platform');
  const resultCount = document.querySelector<HTMLElement>('#directory-result-count');
  const reset = document.querySelector<HTMLButtonElement>('#directory-reset');
  const empty = document.querySelector<HTMLElement>('[data-directory-empty]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-directory-row]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-directory-section]')];
  const groupButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-group-filter]')];
  let activeGroup = 'all';

  if (controls) controls.hidden = false;
  if (filterReturn) filterReturn.hidden = false;

  const updateFilterReturnVisibility = () => {
    if (!controls || !filterReturn) return;
    const footerBounds = footer?.getBoundingClientRect();
    const footerVisible = footerBounds && footerBounds.top < window.innerHeight && footerBounds.bottom > 0;
    filterReturn.hidden = controls.getBoundingClientRect().bottom > 0 || Boolean(footerVisible);
  };
  updateFilterReturnVisibility();
  window.addEventListener('scroll', updateFilterReturnVisibility, { passive: true });
  window.addEventListener('resize', updateFilterReturnVisibility);

  const normalize = (value: string) => value.trim().toLocaleLowerCase();
  const projectCountLabel = (count: number) => `${count} ${count === 1 ? 'project' : 'projects'}`;

  function updateDirectory() {
    const query = normalize(search?.value ?? '');
    const selectedForm = form?.value ?? '';
    const selectedPlatform = platform?.value ?? '';
    let visible = 0;

    for (const row of rows) {
      const matches =
        (activeGroup === 'all' || row.dataset.group === activeGroup) &&
        (!selectedForm || (row.dataset.form ?? '').split('|').includes(selectedForm)) &&
        (!selectedPlatform || (row.dataset.platforms ?? '').split('|').includes(selectedPlatform)) &&
        (!query || (row.dataset.search ?? '').includes(query));
      row.hidden = !matches;
      if (matches) visible += 1;
    }

    for (const section of sections) {
      const sectionRows = [...section.querySelectorAll<HTMLElement>('[data-directory-row]')];
      const sectionVisible = sectionRows.filter((row) => !row.hidden).length;
      section.hidden = sectionVisible === 0;
      const count = section.querySelector<HTMLElement>('[data-directory-section-count]');
      if (count) {
        count.textContent =
          sectionVisible === sectionRows.length
            ? projectCountLabel(sectionVisible)
            : `${projectCountLabel(sectionVisible)} of ${sectionRows.length} total`;
      }
    }

    if (resultCount) {
      resultCount.textContent =
        visible === rows.length
          ? `Showing all ${projectCountLabel(visible)}`
          : `Showing ${projectCountLabel(visible)} of ${rows.length} total`;
    }
    if (filterReturnCount) filterReturnCount.textContent = String(visible);
    if (filterReturnLabel) filterReturnLabel.textContent = visible === 1 ? 'result' : 'results';
    if (empty) empty.hidden = visible !== 0;
    if (root) root.hidden = visible === 0;
    updateFilterReturnVisibility();
  }

  function resetDirectory() {
    if (search) search.value = '';
    if (form) form.value = '';
    if (platform) platform.value = '';
    activeGroup = 'all';
    for (const button of groupButtons) {
      button.setAttribute('aria-pressed', String(button.dataset.groupFilter === 'all'));
    }
    updateDirectory();
    search?.focus();
  }

  search?.addEventListener('input', updateDirectory);
  form?.addEventListener('change', updateDirectory);
  platform?.addEventListener('change', updateDirectory);
  reset?.addEventListener('click', resetDirectory);
  filterReturn?.addEventListener('click', () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    controls?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    window.setTimeout(() => search?.focus({ preventScroll: true }), reduceMotion ? 0 : 350);
  });
  document.querySelector('[data-empty-reset]')?.addEventListener('click', resetDirectory);

  for (const button of groupButtons) {
    button.addEventListener('click', () => {
      activeGroup = button.dataset.groupFilter ?? 'all';
      for (const candidate of groupButtons) {
        candidate.setAttribute('aria-pressed', String(candidate === button));
      }
      updateDirectory();
    });
  }
</script>

<style>
  .directory-world {
    min-height: 100vh;
    --directory-columns: minmax(22rem, 1.35fr) minmax(9rem, 0.45fr) minmax(15rem, 0.72fr) minmax(12rem, 0.6fr) minmax(9rem, 0.45fr);
    --directory-line: var(--line);
    --directory-pane: var(--surface);
    --directory-quiet: var(--ink-muted);
    background: var(--bg);
    color: var(--ink);
  }

  .directory-world :global(:focus-visible) {
    outline: 2px solid var(--copper-hi);
    outline-offset: 2px;
    box-shadow: none;
  }

  .directory-shell {
    width: var(--frame-width);
    margin-inline: auto;
    padding-bottom: 1rem;
  }

  .directory-intro,
  .directory-controls,
  .directory-sections,
  .directory-empty,
  .directory-provenance {
    border-inline: 1px solid var(--line);
  }

  .directory-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.3fr);
    gap: 1px;
    padding-top: 1px;
    background: var(--line);
  }

  .directory-intro > *,
  .directory-controls > *,
  .directory-summary > * {
    min-width: 0;
  }

  .directory-intro-copy,
  .directory-count-pane {
    min-height: 27rem;
    padding: clamp(2rem, 6vw, 5.5rem);
  }

  .directory-intro-copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--surface);
  }

  .directory-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .directory-intro h1 {
    max-width: 14ch;
    margin-top: 1.25rem;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .directory-intro-copy > p:last-child {
    max-width: 64ch;
    margin-top: 2rem;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
  }

  .directory-count-pane {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--surface);
    color: #fff;

  border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .directory-count-pane strong {
    font-size: clamp(5rem, 11vw, 10rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.8;
  }

  .directory-count-pane span {
    max-width: 9ch;
    font-size: clamp(1.7rem, 3vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .directory-count-pane small {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .directory-controls {
    position: sticky;
    top: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: minmax(16rem, 1.3fr) minmax(18rem, 1fr);
    gap: 1.5rem 3rem;
    padding: 1.5rem clamp(1rem, 3vw, 2.5rem);
    background: var(--line);
    color: #fff;
  }

  .directory-search label,
  .directory-selects label > span {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--ink-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .directory-search input,
  .directory-selects select {
    width: 100%;
    min-height: 3rem;
    border: 1px solid var(--ink-muted);
    border-radius: var(--radius);
    background: var(--line);
    color: #fff;
    font: inherit;
  }

  .directory-search input {
    padding: 0 0.9rem;
  }

  .directory-search input::placeholder {
    color: var(--ink-muted);
  }

  .directory-selects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .directory-selects select {
    padding: 0 2.2rem 0 0.75rem;
  }

  .directory-groups {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .directory-groups button,
  .directory-result-line button,
  .directory-empty button {
    min-height: 2.75rem;
    border: 1px solid var(--ink-muted);
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 650;
    cursor: pointer;
  }

  .directory-groups button[aria-pressed='true'] {
    border-color: #fff;
    background: #fff;
    color: var(--bg);
  }

  .directory-result-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-muted);
    font-size: 0.82rem;
  }

  .directory-result-line button {
    border: 0;
    padding-inline: 0;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .directory-section {
    padding-top: 1px;
    background: var(--line);

  border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .directory-section-head {
    display: grid;
    grid-template-columns: minmax(15rem, 0.55fr) minmax(18rem, 1fr);
