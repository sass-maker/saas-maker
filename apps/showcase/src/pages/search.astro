---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { SEARCH_INDEX, SEARCH_TYPES, type SearchEntry } from '../data/searchIndex';
import Layout from '../layouts/Layout.astro';

const TYPE_LABELS: Record<string, string> = {
  page: 'Pages',
  product: 'Products',
  idea: 'Ideas',
  funding: 'Funding',
  doc: 'Docs',
  launchdesk: 'Launch catalog',
  tool: 'Tools',
  learning: 'Learnings',
};

const groups = SEARCH_TYPES.map((type) => ({
  type,
  label: TYPE_LABELS[type] ?? type,
  entries: SEARCH_INDEX.filter((entry) => entry.type === type),
}));

const haystack = (entry: SearchEntry) =>
  `${entry.title} ${entry.summary} ${entry.keywords}`.toLowerCase();
---

<Layout
  title="Search — SaaS Maker"
  description="Search every public SaaS Maker surface — products, ideas, funding programs, launch destinations, tools, and learnings."
>
  <div class="workshop-world interior-world tooling-world">
    <Nav />
    <main id="main-content" class="search-shell">
      <header class="tooling-intro">
        <div class="tooling-intro-copy">
          <p class="directory-kicker">Everything, one index</p>
          <h1>Search the whole site.</h1>
          <p>
            {SEARCH_INDEX.length} entries across products, ideas, funding programs, launch
            destinations, tools, docs, and learnings. Agents: the same index lives at
            <a href="/search.json">/search.json</a> — fetch once, filter on
            <code>title + summary + keywords</code>.
          </p>
        </div>
      </header>

      <div class="search-controls">
        <input
          id="search-input"
          type="search"
          placeholder="Search products, programs, domains, tools…"
          autocomplete="off"
          aria-label="Search the site"
        />
        <div class="search-types" id="search-types" role="group" aria-label="Filter by type">
          {groups.map((group) => (
            <button type="button" data-type={group.type} class="type-chip">
              {group.label} <span>{group.entries.length}</span>
            </button>
          ))}
        </div>
      </div>

      <p id="search-count" class="search-count" role="status" aria-live="polite">
        {SEARCH_INDEX.length} entries — filter above or browse below.
      </p>

      {groups.map((group) => (
        <section class="search-group" data-group={group.type}>
          <h2 class="group-head">{group.label} <span>{group.entries.length}</span></h2>
          <ol class="search-results">
            {group.entries.map((entry) => (
              <li data-hay={haystack(entry)}>
                <a href={entry.url}>
                  <span class="result-title">{entry.title}</span>
                  <span class="result-url">{entry.url}</span>
                  {entry.summary && <span class="result-summary">{entry.summary}</span>}
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .search-shell {
    width: min(86rem, calc(100% - 3rem));
    margin-inline: auto;
    padding: clamp(2rem, 4vw, 3rem) 0 clamp(5rem, 9vw, 8rem);
  }

  .search-controls {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: sticky;
    top: 0;
    z-index: 10;
    padding-block: 0.75rem;
    background: var(--bg);
  }

  #search-input {
    width: 100%;
    max-width: 42rem;
    padding: 0.7rem 1rem;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
  }

  #search-input:focus-visible {
    outline: 2px solid var(--copper-hi);
    outline-offset: 2px;
  }

  .search-types {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .type-chip {
    padding: 0.3rem 0.75rem;
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }

  .type-chip span {
    color: var(--ink-muted);
    margin-left: 0.25rem;
  }

  .type-chip[aria-pressed='true'] {
    color: var(--surface);
    background: var(--ink);
    border-color: var(--ink);
  }

  .search-count {
    margin: 1.25rem 0 0;
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  .search-group {
    margin-top: 2rem;
  }

  .search-group[hidden] {
    display: none;
  }

  .group-head {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }

  .group-head span {
    color: var(--ink-soft);
    font-weight: 400;
  }

  .search-results {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    overflow: hidden;
  }

  .search-results li[hidden] {
    display: none;
  }

  .search-results li + li {
    border-top: 1px solid var(--line);
  }

  .search-results a {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    padding: 0.6rem 1.1rem;
    color: var(--ink);
    text-decoration: none;
  }

  .search-results a:hover {
    background: color-mix(in srgb, var(--ink) 4%, var(--surface));
  }

  .result-title {
    font-weight: 600;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .result-url {
    font-size: 0.78rem;
    color: var(--ink-muted);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    align-self: center;
  }

  .result-summary {
    grid-column: 1 / -1;
    font-size: 0.82rem;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 560px) {
    .search-results a {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement;
  const count = document.getElementById('search-count') as HTMLElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.type-chip')];
  const groups = [...document.querySelectorAll<HTMLElement>('.search-group')];
  const rows = [...document.querySelectorAll<HTMLLIElement>('.search-results li')];
  const activeTypes = new Set<string>();

  const params = new URLSearchParams(location.search);
  const q = params.get('q');
  const t = params.get('type');
  if (q) input.value = q;
  if (t && chips.some((c) => c.dataset.type === t)) {
    activeTypes.add(t);
    chips.find((c) => c.dataset.type === t)!.setAttribute('aria-pressed', 'true');
  }

  function run() {
    const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let visible = 0;
    for (const row of rows) {
      const groupType = row.closest('.search-group')!.getAttribute('data-group')!;
      const show =
        (!activeTypes.size || activeTypes.has(groupType)) &&
        (!terms.length || terms.every((term) => row.dataset.hay!.includes(term)));
      row.hidden = !show;
      if (show) visible++;
    }
    for (const group of groups) {
      const type = group.getAttribute('data-group')!;
      const typeAllowed = !activeTypes.size || activeTypes.has(type);
      const hasVisible = !!group.querySelector('li:not([hidden])');
      group.hidden = !typeAllowed || !hasVisible;
    }
    count.textContent = terms.length
      ? `${visible} result${visible === 1 ? '' : 's'}`
      : `${visible} entries — filter above or browse below.`;
  }

  input.addEventListener('input', run);
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const type = chip.dataset.type!;
      if (activeTypes.delete(type)) chip.removeAttribute('aria-pressed');
      else {
        activeTypes.add(type);
        chip.setAttribute('aria-pressed', 'true');
      }
      run();
    })
  );
  run();
</script>
