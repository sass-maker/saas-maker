---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { SEARCH_INDEX, SEARCH_TYPES } from '../data/searchIndex';
import Layout from '../layouts/Layout.astro';

const TYPE_LABELS: Record<string, string> = {
  page: 'Pages',
  product: 'Products',
  idea: 'Ideas',
  funding: 'Funding',
  doc: 'Docs',
  launchdesk: 'Launch catalog',
  tool: 'Tools',
  learning: 'Learnings',
};
---

<Layout
  title="Search — SaaS Maker"
  description="Search every public SaaS Maker surface — products, ideas, funding programs, launch destinations, tools, and learnings."
>
  <div class="workshop-world interior-world tooling-world">
    <Nav />
    <main id="main-content" class="search-shell">
      <header class="tooling-intro">
        <div class="tooling-intro-copy">
          <p class="directory-kicker">Everything, one index</p>
          <h1>Search the whole site.</h1>
          <p>
            {SEARCH_INDEX.length} entries across products, ideas, funding programs, launch
            destinations, tools, docs, and learnings. Agents: the same index lives at
            <a href="/search.json">/search.json</a> — fetch once, filter on
            <code>title + summary + keywords</code>.
          </p>
        </div>
      </header>

      <div class="search-controls">
        <input
          id="search-input"
          type="search"
          placeholder="Search products, programs, domains, tools…"
          autocomplete="off"
          aria-label="Search the site"
        />
        <div class="search-types" id="search-types" role="group" aria-label="Filter by type">
          {SEARCH_TYPES.map((type) => (
            <button type="button" data-type={type} class="type-chip">
              {TYPE_LABELS[type] ?? type}
            </button>
          ))}
        </div>
      </div>

      <p id="search-count" class="search-count" role="status" aria-live="polite"></p>
      <ol id="search-results" class="search-results"></ol>

      <noscript>
        <p class="search-count">
          Search needs JavaScript — the full index is available as
          <a href="/search.json">/search.json</a>.
        </p>
      </noscript>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .search-shell {
    width: min(86rem, calc(100% - 3rem));
    margin-inline: auto;
    padding: clamp(2rem, 4vw, 3rem) 0 clamp(5rem, 9vw, 8rem);
  }

  .search-controls {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  #search-input {
    width: 100%;
    max-width: 42rem;
    padding: 0.7rem 1rem;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
  }

  #search-input:focus-visible {
    outline: 2px solid var(--copper-hi);
    outline-offset: 2px;
  }

  .search-types {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .type-chip {
    padding: 0.3rem 0.75rem;
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }

  .type-chip[aria-pressed='true'] {
    color: var(--surface);
    background: var(--ink);
    border-color: var(--ink);
  }

  .search-count {
    margin: 1.25rem 0 0;
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  .search-results {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    overflow: hidden;
  }

  .search-results li + li {
    border-top: 1px solid var(--line);
  }

  .search-results a {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.5rem 1.25rem;
    padding: 0.75rem 1.1rem;
    color: var(--ink);
    text-decoration: none;
  }

  .search-results a:hover {
    background: color-mix(in srgb, var(--ink) 4%, var(--surface));
  }

  .result-type {
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-top: 0.2rem;
  }

  .result-title {
    font-weight: 600;
  }

  .result-summary {
    grid-column: 2;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  @media (max-width: 560px) {
    .search-results a {
      grid-template-columns: 1fr;
    }
    .result-type {
      padding-top: 0;
    }
    .result-summary {
      grid-column: 1;
    }
  }
</style>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement;
  const list = document.getElementById('search-results') as HTMLOListElement;
  const count = document.getElementById('search-count') as HTMLElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.type-chip')];

  const TYPE_LABELS: Record<string, string> = {
    page: 'Pages', product: 'Products', idea: 'Ideas', funding: 'Funding',
    doc: 'Docs', launchdesk: 'Launch catalog', tool: 'Tools', learning: 'Learnings',
  };

  let index: { type: string; title: string; url: string; summary: string; keywords: string }[] = [];
  const activeTypes = new Set<string>();

  fetch('/search.json')
    .then((r) => r.json())
    .then((data) => {
      index = data.index;
      run();
    })
    .catch(() => {
      count.textContent = 'Search index failed to load — try /search.json directly.';
    });

  const params = new URLSearchParams(location.search);
  const q = params.get('q');
  const t = params.get('type');
  if (q) input.value = q;
  if (t && chips.some((c) => c.dataset.type === t)) {
    activeTypes.add(t);
    chips.find((c) => c.dataset.type === t)!.setAttribute('aria-pressed', 'true');
  }

  function run() {
    const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    const hits = index.filter((entry) => {
      if (activeTypes.size && !activeTypes.has(entry.type)) return false;
      if (!terms.length) return false;
      const hay = `${entry.title} ${entry.summary} ${entry.keywords}`.toLowerCase();
      return terms.every((term) => hay.includes(term));
    });
    count.textContent = terms.length
      ? `${hits.length} result${hits.length === 1 ? '' : 's'}`
      : 'Type to search the full index.';
    list.replaceChildren(
      ...hits.slice(0, 200).map((entry) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = entry.url;
        const type = document.createElement('span');
        type.className = 'result-type';
        type.textContent = TYPE_LABELS[entry.type] ?? entry.type;
        const title = document.createElement('span');
        title.className = 'result-title';
        title.textContent = entry.title;
        const summary = document.createElement('span');
        summary.className = 'result-summary';
        summary.textContent = entry.summary;
        a.append(type, title, summary);
        li.append(a);
        return li;
      })
    );
  }

  input.addEventListener('input', run);
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const type = chip.dataset.type!;
      if (activeTypes.delete(type)) chip.removeAttribute('aria-pressed');
      else {
        activeTypes.add(type);
        chip.setAttribute('aria-pressed', 'true');
      }
      run();
    })
  );
</script>
