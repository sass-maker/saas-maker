---
/**
 * THESIS: The funding directory is working material, like the launch catalog — the
 * value is comparing fit, terms, and evidence, not scrolling a list of logos.
 * OWN-WORLD: Same workshop interior as /launchdesk; programs render as an operator
 * ledger with the workspace's own decision views as presets.
 * STORY: See the honest counts, pick a decision view or narrow by fit, then open a
 * program's full record before trusting its assessment.
 * FIRST VIEWPORT: Studio navigation, identity bay with counts, then the controls and ledger.
 * FORM: Operator ledger within the established workshop wall; no new visual world.
 */
import AgentPrompt from '../components/AgentPrompt.astro';
import Footer from '../components/Footer.astro';
import CatalogActions from '../components/CatalogActions.astro';
import Nav from '../components/Nav.astro';
import { FUNDING_AGENT_PROMPT } from '../data/catalogPrompts';
import {
  FUNDING,
  FUNDING_CATEGORIES,
  FUNDING_DOCS,
  FUNDING_FITS,
  FUNDING_PRIORITIES,
  FUNDING_PROGRAMS_SORTED,
  FUNDING_VIEW_ORDER,
  FUNDING_VIEWS,
  field,
} from '../data/funding';
import Layout from '../layouts/Layout.astro';

const programs = FUNDING_PROGRAMS_SORTED;
const valuesFor = (name: string) => [...new Set(programs.map(program => field(program, name)).filter(Boolean))].sort() as string[];
const statuses = valuesFor('External Status');
const evidenceLevels = valuesFor('Evidence Quality');

const viewMembership = new Map(
  programs.map((program) => [
    program.slug,
    FUNDING_VIEWS.filter((view) => view.slugs.includes(program.slug)).map((view) => view.key),
  ])
);

const shortlist = FUNDING_VIEWS.find((view) => view.key === 'current-shortlist');

const deadlineText = (program: (typeof programs)[number]) =>
  (field(program, 'Deadline') as string | null) ?? null;
---

<Layout
  title={`Funding directory — ${programs.length} programs with honest evidence | SaaS Maker`}
  description={`${programs.length} accelerators, residencies, funds, credit schemes, and resources across ${FUNDING_CATEGORIES.length} categories — with fit, terms, deadlines, and evidence quality preserved per row.`}
>
  <div class="workshop-world interior-world funding-world">
    <Nav />
    <main id="main-content" class="funding-page">
      <header class="funding-hero">
        <div class="funding-identity">
          <p class="funding-kicker">SaaS Maker / Funding directory</p>
          <h1>Every program, honestly graded.</h1>
          <p>
            {programs.length} accelerators, residencies, funds, credits, and resources —
            one row per specific program, with uncertainty preserved instead of smoothed
            away. Originally the Funding &amp; Accelerators workspace; now it lives here.
          </p>
        </div>
        <dl class="funding-summary" aria-label="Directory summary">
          <div>
            <dt>Programs</dt>
            <dd>{programs.length}</dd>
          </div>
          <div>
            <dt>Current shortlist</dt>
            <dd>{shortlist?.slugs.length ?? 0}</dd>
          </div>
          <div>
            <dt>Categories</dt>
            <dd>{FUNDING_CATEGORIES.length}</dd>
          </div>
        </dl>
      </header>

      <AgentPrompt
        title="Find the right opportunities with your agent"
        description="Copy the prompt, add your project and constraints, and let your agent build a shortlist from current official sources. No account or repository setup needed."
        prompt={FUNDING_AGENT_PROMPT}
      />

      <section class="funding-workbench" aria-labelledby="funding-directory-title">
        <div class="funding-intro">
          <div>
            <p class="funding-kicker">Decision views</p>
            <h2 id="funding-directory-title">Same sixteen cuts the workspace used.</h2>
          </div>
          <details>
            <summary>How to read the rows</summary>
            <p>
              <strong>Priority</strong> and <strong>Fit</strong> are assessed for this
              portfolio's stage — they are judgment, not the program's own claim.
              <strong>Evidence</strong> records where each row's facts came from;
              "unresolved" means nobody could confirm it.
            </p>
            <p>
              Decision views reproduce the original workspace's filters and ordering
              exactly. Pick one, then narrow further with the controls. Workspace
              rebuilt {FUNDING.workspaceRebuilt}; per-row verification dates ship in
              each program's record.
            </p>
          </details>
        </div>

        <form class="funding-controls" data-fd-controls>
          <label class="funding-search">
            <span>Search programs</span>
            <input
              type="search"
              name="query"
              placeholder="Program, organization, location or terms…"
              autocomplete="off"
              data-fd-query
            />
          </label>

          <label>
            <span>Decision view</span>
            <select name="view" data-fd-view>
              <option value="">All opportunities</option>
              {FUNDING_VIEWS.map((view) => (
                <option value={view.key}>
                  {view.label} ({view.slugs.length})
                </option>
              ))}
            </select>
          </label>

          <label>
            <span>Category</span>
            <select name="category" data-fd-category>
              <option value="">All categories</option>
              {FUNDING_CATEGORIES.map((category) => <option value={category}>{category}</option>)}
            </select>
          </label>

          <label>
            <span>Priority</span>
            <select name="priority" data-fd-priority>
              <option value="">Any priority</option>
              {FUNDING_PRIORITIES.map((priority) => <option value={priority}>{priority}</option>)}
            </select>
          </label>

          <label>
            <span>Fit</span>
            <select name="fit" data-fd-fit>
              <option value="">Any fit</option>
              {FUNDING_FITS.map((fit) => <option value={fit}>{fit}</option>)}
            </select>
          </label>

          <label>
            <span>Program status</span>
            <select name="status" data-fd-status>
              <option value="">Any status</option>
              {statuses.map(status => <option value={status}>{status}</option>)}
            </select>
          </label>
          <label>
            <span>Evidence quality</span>
            <select name="evidence" data-fd-evidence>
              <option value="">Any evidence</option>
              {evidenceLevels.map(evidence => <option value={evidence}>{evidence}</option>)}
            </select>
          </label>
          <label class="funding-sort-mobile">
            <span>Sort</span>
            <select name="sort" data-fd-sort>
              <option value="view:asc">Default / decision view order</option>
              <option value="priority:asc">Priority, high to low</option>
              <option value="priority:desc">Priority, low to high</option>
              <option value="name:asc">Program, A–Z</option>
              <option value="name:desc">Program, Z–A</option>
              <option value="category:asc">Category, A–Z</option>
              <option value="category:desc">Category, Z–A</option>
              <option value="fit:asc">Portfolio fit, strongest first</option>
              <option value="fit:desc">Portfolio fit, weakest first</option>
              <option value="deadline:asc">Deadline, soonest</option>
              <option value="deadline:desc">Deadline, latest</option>
              <option value="verified:desc">Last verified, newest first</option>
              <option value="verified:asc">Last verified, oldest first</option>
            </select>
          </label>

          <div class="funding-result-line">
            <output data-fd-count aria-live="polite">Showing all {programs.length} programs</output>
            <CatalogActions />
          </div>
        </form>

        <div class="funding-table-wrap">
          <table class="funding-table">
            <thead>
              <tr>
                <th scope="col" data-sort-heading="priority" aria-sort="ascending">
                  <button type="button" data-sort="priority">Priority</button>
                </th>
                <th scope="col" data-sort-heading="name">
                  <button type="button" data-sort="name">Program</button>
                </th>
                <th scope="col" data-sort-heading="category">
                  <button type="button" data-sort="category">Category</button>
                </th>
                <th scope="col" data-sort-heading="fit">
                  <button type="button" data-sort="fit">Fit now</button>
                </th>
                <th scope="col" data-sort-heading="deadline">
                  <button type="button" data-sort="deadline">Deadline</button>
                </th>
                <th scope="col">Source</th>
              </tr>
            </thead>
            <tbody data-fd-body>
              {programs.map((program) => {
                const org = field(program, 'Organization') as string | null;
                const category = (field(program, 'Category') as string | null) ?? '';
                const priority = (field(program, 'Priority') as string | null) ?? '';
                const fit = (field(program, 'Fit for Current Stage') as string | null) ?? '';
                const deadline = deadlineText(program);
                const officialUrl = field(program, 'Official URL') as string | null;
                const nextAction = field(program, 'Next Action') as string | null;
                const terms = field(program, 'Investment Terms') as string | null;
                const status = field(program, 'External Status') as string | null;
                const evidence = field(program, 'Evidence Quality') as string | null;
                const verified = field(program, 'Last Verified') as string | null;
                const priorityKey = priority.split(' ')[0].toLowerCase();
                return (
                  <tr
                    data-fd-row
                    data-slug={program.slug}
                    data-name={`${program.name} ${Object.values(program.fields).join(' ')}`.toLowerCase()}
                    data-namekey={program.name.toLowerCase()}
                    data-title={program.name}
                    data-org={org ?? ''}
                    data-official={officialUrl ?? ''}
                    data-category={category}
                    data-priority={priority}
                    data-fit={fit}
                    data-deadline={deadline ?? ''}
                    data-status={status ?? ''}
                    data-evidence={evidence ?? ''}
                    data-verified={verified ?? ''}
                    data-views={(viewMembership.get(program.slug) ?? []).join(',')}
                  >
                    <td class="fd-priority" data-label="Priority">
                      {priority ? (
                        <span class={`fd-pill fd-pill--${priorityKey}`}>{priority}</span>
                      ) : (
                        <span class="fd-blank" title="Not assessed">—</span>
                      )}
                    </td>
                    <td class="fd-program" data-label="Program">
                      <details class="fd-disclosure">
                        <summary>
                          <span class="fd-name">{program.name}</span>
                          <span class="fd-org">{org ?? '—'}</span>
                        </summary>
                        <div class="fd-detail">
                          {nextAction && <p><strong>Next action:</strong> {nextAction}</p>}
                          {terms && <p>{terms}</p>}
                          <p>{status ?? 'Status unreported'} · {evidence ?? 'Evidence unreported'} · Last verified: {verified ?? 'unreported'}</p>
                          <p>
                            <a href={`/funding/${program.slug}`}>Full record →</a>
                            {' · '}
                            <a href={`/funding/${program.slug}.json`}>JSON</a>
                          </p>
                        </div>
                      </details>
                    </td>
                    <td class="fd-tag" data-label="Category">
                      {category || <span class="fd-blank">—</span>}
                    </td>
                    <td class="fd-tag" data-label="Fit now">
                      {fit || <span class="fd-blank">—</span>}
                    </td>
                    <td class="fd-tag fd-deadline" data-label="Deadline">
                      {deadline ? (
                        <time datetime={deadline}>{deadline.replace('→', ' → ')}</time>
                      ) : (
                        <span class="fd-blank" title="No deadline recorded">—</span>
                      )}
                    </td>
                    <td class="fd-source" data-label="Source">
                      {officialUrl ? (
                        <a href={officialUrl} target="_blank" rel="noopener noreferrer" class="fd-route-link">
                          Official ↗
                        </a>
                      ) : (
                        <span class="fd-blank">unresolved</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <div class="funding-empty" data-fd-empty hidden>
          <strong>No programs match this cut.</strong>
          <p>Reset the controls to return to the complete directory.</p>
          <button type="button" data-fd-empty-reset>Show all programs</button>
        </div>
      </section>

      <section class="funding-docs" aria-labelledby="funding-docs-title">
        <div class="funding-intro">
          <div>
            <p class="funding-kicker">Behind the directory</p>
            <h2 id="funding-docs-title">The workspace around the rows.</h2>
          </div>
        </div>
        <div class="funding-docs-grid">
          {FUNDING_DOCS.map((doc) => (
            <a class="funding-doc" href={`/funding/docs/${doc.slug}`}>
              <strong>{doc.title}</strong>
              <span>{doc.description}</span>
            </a>
          ))}
        </div>
      </section>

      <aside class="funding-method" aria-labelledby="funding-method-title">
        <div>
          <p class="funding-kicker">Provenance</p>
          <h2 id="funding-method-title">One row per program, uncertainty kept.</h2>
        </div>
        <div>
          <p>
            This directory was imported from a maintained workspace rebuilt
            {' '}{FUNDING.workspaceRebuilt}. Organizations are split when programs
            materially differ; stale, niche, and unresolved items stay searchable
            rather than being deleted or presented as fact. Assessments — fit,
            priority, recommendation — are this portfolio's judgment, not the
            programs' claims.
          </p>
          <a href="/funding.json">Open the complete JSON dataset <span aria-hidden="true">→</span></a>
          <a href="https://github.com/sass-maker/saas-maker" target="_blank" rel="noopener noreferrer">
            SaaS Maker source <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </main>
    <Footer />
  </div>
</Layout>

<script type="application/json" data-fd-view-order set:html={JSON.stringify(FUNDING_VIEW_ORDER)} />

<script>
  import { bindCatalogControls, compareKnown, recordedDate } from '../lib/catalog-controls';

  const controls = document.querySelector<HTMLFormElement>('[data-fd-controls]');
  const body = document.querySelector<HTMLElement>('[data-fd-body]');
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('[data-fd-row]'));
  const query = controls?.querySelector<HTMLInputElement>('[data-fd-query]');
  const view = controls?.querySelector<HTMLSelectElement>('[data-fd-view]');
  const sort = controls?.querySelector<HTMLSelectElement>('[data-fd-sort]');
  const count = document.querySelector<HTMLElement>('[data-fd-count]');
  const empty = document.querySelector<HTMLElement>('[data-fd-empty]');
  const viewOrderEl = document.querySelector('[data-fd-view-order]');
  const viewOrder: Record<string, string[]> = JSON.parse(viewOrderEl?.textContent || '{}');
  const PRIORITY_RANK: Record<string, number> = { p0: 0, p1: 1, p2: 2, monitor: 3, skip: 4, archive: 5 };
  const FIT_RANK: Record<string, number> = { 'Excellent now': 0, 'Good now': 1, 'Possible now': 2, Later: 3, 'Poor fit': 4, 'Not applicable': 5 };

  function valueFor(row: HTMLTableRowElement, key: string) {
    if (key === 'priority') return PRIORITY_RANK[(row.dataset.priority || '').split(' ')[0].toLowerCase()] ?? null;
    if (key === 'fit') return FIT_RANK[row.dataset.fit ?? ''] ?? null;
    if (key === 'name') return row.dataset.namekey ?? '';
    if (key === 'deadline' || key === 'verified') return recordedDate(row.dataset[key]);
    return row.dataset[key] || null;
  }

  function render() {
    if (!body || !count || !empty) return;
    const search = query?.value.trim().toLowerCase() ?? '';
    const viewKey = view?.value ?? '';
    const [sortKey, direction] = (sort?.value || 'view:asc').split(':');
    const orderIndex = sortKey === 'view' && viewKey && viewOrder[viewKey]
      ? new Map(viewOrder[viewKey].map((slug, index) => [slug, index])) : null;
    const ordered = rows.toSorted((a, b) => {
      if (orderIndex) return (orderIndex.get(a.dataset.slug ?? '') ?? 9999) - (orderIndex.get(b.dataset.slug ?? '') ?? 9999);
      return compareKnown(valueFor(a, sortKey === 'view' ? 'priority' : sortKey), valueFor(b, sortKey === 'view' ? 'priority' : sortKey), direction)
        || (a.dataset.namekey ?? '').localeCompare(b.dataset.namekey ?? '');
    });
    let visibleCount = 0;
    for (const row of ordered) {
      const matches = (!viewKey || (row.dataset.views ?? '').split(',').includes(viewKey))
        && ['category', 'priority', 'fit', 'status', 'evidence'].every(key => {
          const value = controls?.querySelector<HTMLSelectElement>(`[data-fd-${key}]`)?.value;
          return !value || row.dataset[key] === value;
        })
        && (!search || row.dataset.name?.includes(search));
      row.hidden = !matches;
      if (matches) visibleCount += 1;
      body.append(row);
    }
    count.textContent = visibleCount === rows.length ? `Showing all ${rows.length} programs` : `Showing ${visibleCount} of ${rows.length} programs`;
    empty.hidden = visibleCount > 0;
    document.querySelectorAll<HTMLElement>('[data-sort-heading]').forEach(heading => {
      const activeKey = sortKey === 'view' && !orderIndex ? 'priority' : sortKey;
      if (heading.dataset.sortHeading === activeKey) heading.setAttribute('aria-sort', direction === 'desc' ? 'descending' : 'ascending');
      else heading.removeAttribute('aria-sort');
    });
  }

  function exportRows() {
    const visible = Array.from(body?.querySelectorAll<HTMLTableRowElement>('[data-fd-row]') ?? []).filter(row => !row.hidden);
    return [['Program', 'Organization', 'Category', 'Portfolio priority', 'Portfolio fit', 'Recorded deadline', 'Program status', 'Evidence quality', 'Last verified', 'Official URL', 'Record URL'],
      ...visible.map(({ dataset: d }) => [d.title, d.org, d.category, d.priority, d.fit, d.deadline, d.status, d.evidence, d.verified, d.official, new URL(`/funding/${d.slug}`, location.origin).href])];
  }

  if (controls) {
    // A view narrows membership. Choosing another sort must keep that membership.
    view?.addEventListener('change', () => { if (sort) sort.value = 'view:asc'; });
    const update = bindCatalogControls(controls, render, exportRows, 'funding-results.csv');
    document.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach(button => {
      button.addEventListener('click', () => {
        if (!sort) return;
        const [rawKey, direction] = sort.value.split(':');
        const key = rawKey === 'view' && !view?.value ? 'priority' : rawKey;
        sort.value = `${button.dataset.sort}:${key === button.dataset.sort && direction === 'asc' ? 'desc' : 'asc'}`;
        update();
      });
    });
    document.querySelector('[data-fd-empty-reset]')?.addEventListener('click', () => { controls.reset(); query?.focus(); });
  }
</script>

<style>
  .funding-page {
    width: var(--frame-width);
    margin-inline: auto;
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .funding-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(19rem, 0.7fr);
    gap: 1px;
    padding: 1px;
    padding-top: 0;
    background: var(--line);

  border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .funding-identity,
  .funding-summary {
    border: 0;
    background: var(--surface);

  border-radius: var(--radius);
}

  .funding-identity {
    padding: clamp(3rem, 6vw, 6rem);
  }

  .funding-kicker {
    color: var(--copper-hi);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .funding-identity h1 {
    max-width: 11ch;
    margin-top: 1.25rem;
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .funding-identity > p:last-child {
    max-width: 42rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.7vw, 1.25rem);
  }

  .funding-summary {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    list-style: none;
  }

  .funding-summary > div {
    min-height: 8.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .funding-summary > div:nth-child(2) {
    background: var(--surface-muted);

  border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .funding-summary > div:last-child {
    border-bottom: 0;
    background: var(--surface);
    color: #fff;

  border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .funding-summary dt {
    color: var(--ink-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .funding-summary > div:last-child dt {
    color: rgba(255, 255, 255, 0.75);
  }

  .funding-summary dd {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .funding-workbench,
  .funding-docs {
    width: min(86rem, calc(100% - 3rem));
    margin-inline: auto;
    padding-top: clamp(4rem, 8vw, 7rem);
  }

  .funding-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-bottom: 2rem;
  }

  .funding-intro h2,
  .funding-method h2 {
    max-width: 16ch;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .funding-intro details {
    border-block: 1px solid var(--line-strong);
  }

  .funding-intro summary {
    min-height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    color: var(--ink-soft);
    font-weight: 600;
  }

  .funding-intro summary::after {
    content: '+';
    color: var(--copper-hi);
    font-size: 1.25rem;
  }

  .funding-intro details[open] summary::after {
    content: '−';
  }

  .funding-intro details p {
    margin-bottom: 1rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }

  .funding-controls {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }

  .funding-controls label {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1rem;
    border-right: 1px solid var(--line);
  }

  .funding-controls label > span {
    color: var(--ink-muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .funding-controls input,
  .funding-controls select,
  .funding-controls button,
  .funding-empty button {
    min-height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
    font: inherit;
  }

  .funding-controls input,
  .funding-controls select {
    width: 100%;
    padding: 0.65rem 0.75rem;
  }

  .funding-controls input::placeholder {
    color: var(--ink-muted);
  }

  .funding-sort-mobile {
    display: flex;
  }

  .funding-result-line {
    flex-wrap: wrap;
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
    padding: 0.75rem 1rem;
    color: var(--ink-muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  .funding-result-line button,
  .funding-empty button {
    padding: 0.55rem 0.9rem;
    cursor: pointer;
    color: var(--copper-hi);
    font-weight: 600;
  }

  .funding-table-wrap {
    overflow-x: auto;
    border-inline: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .funding-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
