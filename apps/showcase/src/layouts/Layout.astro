---
import '../styles/globals.css';
import { STUDIO_JSON_LD, STUDIO_PROFILE } from '../data/studio';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const SITE_URL = 'https://sassmaker.com';
const DEFAULT_TITLE = 'SaaS Maker — product studio and public software directory';
const DEFAULT_DESCRIPTION = STUDIO_PROFILE.oneLine;

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  type = 'website',
  publishedTime,
} = Astro.props;

// Cloudflare Pages serves clean URLs without `.html`; canonicals should match.
const pathname =
  Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(pathname, Astro.site).href;

// Social preview image served from the static public asset set.
const OG_IMAGE = `${SITE_URL}/og-image.svg`;
---

<!doctype html>
<Fragment set:html={/<!doctype html/i.test(description) ? '<!DOCTYPE html>' : ''} />
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SaaS Maker" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <meta
      name="keywords"
      content="saas maker, product studio, software product directory, codevetter, posttrainllm, heypace, high signal, sarthak agrawal"
    />
    <meta name="author" content="Sarthak Agrawal" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    {/* One type family keeps the directory calm and reduces font payload. It is
        self-hosted and declared in globals.css, which is inlined into this
        document, so there is no third-party stylesheet, no extra connection
        and no swap reflow (issue #92). `font-display: optional` gives the
        font a short block period and then commits to whichever face won, so
        the preload is what keeps first paint early — dropping it measured
        ~400ms worse FCP, because the block period starts late.
        `fetchpriority="low"` holds it behind the hero image, which is the LCP
        element on mobile; measured neutral locally, where the origin is free,
        and it costs nothing to keep the ordering explicit. */}
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-v7-latin.woff2"
      as="font"
      type="font/woff2"
      fetchpriority="low"
      crossorigin
    />

    {/* Canonical Person → Studio → WebSite graph from the public studio profile. */}
    <script type="application/ld+json" set:html={JSON.stringify(STUDIO_JSON_LD)} />
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_3abfb8cb6ceec20b3f64d0314f110e6d3f82889592fccf3cc8a87f5ac8341f4d"
      data-project="app-23e1f349-eb71-4030-83f6-91b572dbc534"
      data-identity="persistent"
      data-endpoint="https://ingest.sassmaker.com/v1/browser"
      data-vitals
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {/* Directory contacts are already public in JSON. Preserve their text and
        mailto links instead of injecting crawler-visible email-protection 404s. */}
    <!--email_off-->
    <slot />
    <!--/email_off-->
    <link rel="stylesheet" href="/footer.css" />
    <script is:inline type="module" src="/footer.js"></script>
    <style is:global>
      /* Page element rules are unlayered and would beat the library's layered footer CSS. */
      studio-footer { display: block; }
    studio-footer {
      --background: #0b0c0d; --foreground: #f1f0ec; --muted-foreground: #a5a39c;
      --border: #282a2d; --input: #282a2d; --surface: #111315; --card: #111315; --accent: #111315;
      --brand: #d57a43; --brand-ink: #0b0c0d; --brand-soft: rgb(213 122 67 / 0.14);
      --primary: #d57a43; --primary-foreground: #0b0c0d; --ring: #d57a43;
      --font-display: var(--sans); --font-text: var(--sans); --font-sans: var(--sans);
      color-scheme: dark;
    }
      studio-footer *:not(#studio-footer-reset), studio-footer *:not(#studio-footer-reset)::before, studio-footer *:not(#studio-footer-reset)::after { all: revert-layer; }
    </style>
    <studio-footer
      product="SaaS Maker"
      url="https://sassmaker.com"
      catalog-id="saas-maker"
      capture="newsletter"
      variant="studio"
      privacy-url="https://sassmaker.com/privacy"
    >
      <script is:inline type="application/json">
        {
          "summary": "Fleet products and shared tooling. Built and maintained by Sarthak Agrawal.",
          "legal": "Curious products. Real domains. Work that keeps moving.",
          "art": {
            "src": "/footer-art/saas-maker.webp",
            "width": 2170,
            "height": 725,
            "alt": "SaaS Maker: A product studio courtyard centers an active craft table where small software-inspired models are made and inspected. Varied finished and unfinished models occupy a quiet exhibition shelf; useful tools remain on the outer workbenches.",
            "focalX": 50,
            "focalY": 50,
            "credit": "Original illustration for SaaS Maker"
          },
          "groups": [
            {"title": "Explore", "links": [
              {"label": "Products", "href": "/projects"},
              {"label": "Shared tooling", "href": "/tools"},
              {"label": "Ideas", "href": "/ideas"},
              {"label": "LaunchDesk", "href": "/launchdesk"},
              {"label": "Funding", "href": "/funding"}
            ]},
            {"title": "Journal", "links": [
              {"label": "Changelog", "href": "/changelog"},
              {"label": "Learnings", "href": "/learnings"},
              {"label": "Ranks", "href": "/ranks"}
            ]},
            {"title": "Studio", "links": [
              {"label": "Sarthak Agrawal", "href": "https://sarthakagrawal.dev"},
              {"label": "Source", "href": "https://github.com/sass-maker/saas-maker"},
              {"label": "Privacy", "href": "/privacy"},
              {"label": "Terms", "href": "/terms"}
            ]}
          ]
        }
      </script>
    </studio-footer>
    <script is:inline>
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest('[data-app-health-event]');
        const name = link?.getAttribute('data-app-health-event');
        if (!name || !window.appHealth || typeof window.appHealth.track !== 'function') return;
        window.appHealth.track(name);

        if (
          !(link instanceof HTMLAnchorElement) ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          link.target === '_blank' ||
          link.hasAttribute('download')
        ) return;

        event.preventDefault();
        let navigated = false;
        const navigate = () => {
          if (navigated) return;
          navigated = true;
          window.location.assign(link.href);
        };
        window.setTimeout(navigate, 800);
        Promise.resolve(window.appHealth.flush?.()).catch(() => {}).finally(navigate);
      });
    </script>
  </body>
</html>
